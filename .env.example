# Copy to .env.local for local development. Never commit real values.

# --- Drew bot API (server-side only) ---------------------------------------
# Public HTTPS URL of the bot API.
DREW_API_URL=https://api.drewbot.xyz
# Same value as the bot's API_KEY. Signs requests to the bot (HMAC) and
# derives the dashboard session encryption key.
DREW_API_KEY=

# --- Discord OAuth (dashboard login) ----------------------------------------
# Discord Developer Portal > your application.
DISCORD_CLIENT_ID=1441457111409103010
DISCORD_CLIENT_SECRET=
# Must match a redirect registered in the Developer Portal > OAuth2.
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
