 {
  "id": "api",
  "label": "API tokens",
  "order": 930,
  "intro": "Create and manage tokens for the [Configuration API](../developers/api/intro.md).",
  "notes": [
   "Creating a token requires being the server owner or having an active SUDO session. admin tokens can only be created by the owner.",
   "The token is shown once, only to you. Drew stores only its SHA-256 hash."
  ],
  "commands": [
   {
    "name": "/api token create",
    "description": "Create an API token (requires server owner or an active SUDO session).",
    "notes": [],
    "options": [
     {
      "name": "name",
      "type": "Text",
      "required": true,
      "description": "What the token is for, e.g. \"claude-setup\""
     },
     {
      "name": "scope",
      "type": "Text",
      "required": true,
      "description": "What the token can do. Values: read, write, admin."
     },
     {
      "name": "expires",
      "type": "Text",
      "required": false,
      "description": "When the token stops working (default: 30 days). Values: 1, 7, 30, 90, 365."
     }
    ]
   },
   {
    "name": "/api token list",
    "description": "List this server's active API tokens.",
    "notes": [],
    "options": []
   },
   {
    "name": "/api token revoke",
    "description": "Revoke an API token immediately.",
    "notes": [
     "Requires the server owner or an active SUDO session."
    ],
    "options": [
     {
      "name": "token",
      "type": "Text",
      "required": true,
      "description": "Token prefix (drew_xxxxxxxx) or ID from /api token list"
     }
    ]
   },
   {
    "name": "/api docs",
    "description": "How to configure Drew through the API.",
    "notes": [],
    "options": []
   }
  ]
 },
