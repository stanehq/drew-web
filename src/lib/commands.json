[
 {
  "id": "opsec",
  "label": "Security",
  "order": 990,
  "intro": "Configure Drew's protection modules: anti-nuke, anti-raid, punishments, thresholds, whitelists and presets.",
  "notes": [
   "Every subcommand except config and servershow requires an active SUDO session. Run /sudo enter first.",
   "Features that take effect today: nuke (anti-nuke) and raid (anti-raid). links and invites are stored for an upcoming module and have no effect yet.",
   "Punishments and limits that take effect today: nuke, raid, channel_delete, channel_create, role_delete, role_create and join_rate. Other values are accepted and stored for upcoming modules."
  ],
  "commands": [
   {
    "name": "/opsec config",
    "description": "View current security settings.",
    "notes": [],
    "options": [
     {
      "name": "category",
      "type": "Text",
      "required": true,
      "description": "Choose the settings category. Values: anti_nuke, verification, beast_mode, whitelist, backup."
     }
    ]
   },
   {
    "name": "/opsec snapshot",
    "description": "Manage server security snapshots.",
    "notes": [],
    "options": [
     {
      "name": "action",
      "type": "Text",
      "required": true,
      "description": "Action to perform. Values: save, load, delete."
     }
    ]
   },
   {
    "name": "/opsec enable",
    "description": "Enable a protection feature.",
    "notes": [
     "Values for feature: nuke, raid, links, invites."
    ],
    "options": [
     {
      "name": "feature",
      "type": "Text",
      "required": true,
      "description": "Feature to enable"
     }
    ]
   },
   {
    "name": "/opsec disable",
    "description": "Disable a protection feature (Requires SUDO).",
    "notes": [
     "Values for feature: nuke, raid, links, invites."
    ],
    "options": [
     {
      "name": "feature",
      "type": "Text",
      "required": true,
      "description": "Feature to disable"
     }
    ]
   },
   {
    "name": "/opsec punishment",
    "description": "Configure punishment for an action.",
    "notes": [
     "Values for action: nuke, raid, channel_delete, channel_create, role_delete, role_create, dangerous_permissions, admin_role, invite_link, spam, antibot."
    ],
    "options": [
     {
      "name": "action",
      "type": "Text",
      "required": true,
      "description": "The action to punish"
     },
     {
      "name": "type",
      "type": "Text",
      "required": true,
      "description": "Punishment type. Values: none, timeout, kick, ban."
     }
    ]
   },
   {
    "name": "/opsec limit",
    "description": "Configure threshold for an action.",
    "notes": [
     "Values for action: ban, kick, channel_delete, channel_create, role_delete, role_create, join_rate. Limits count actions by one user within 10 seconds (join_rate counts joins)."
    ],
    "options": [
     {
      "name": "action",
      "type": "Text",
      "required": true,
      "description": "The action to limit"
     },
     {
      "name": "threshold",
      "type": "Integer",
      "required": true,
      "description": "Threshold value"
     }
    ]
   },
   {
    "name": "/opsec whitelist",
    "description": "Manage security whitelists.",
    "notes": [],
    "options": [
     {
      "name": "action",
      "type": "Text",
      "required": true,
      "description": "Add/Remove from whitelist. Values: add_user, remove_user, add_role, remove_role."
     },
     {
      "name": "user",
      "type": "User",
      "required": false,
      "description": "The user to whitelist"
     },
     {
      "name": "role",
      "type": "Role",
      "required": false,
      "description": "The role to whitelist"
     }
    ]
   },
   {
    "name": "/opsec setup",
    "description": "Apply a security preset.",
    "notes": [
     "Presets turn anti-nuke and anti-raid on (or off with unprotected) and set the join-rate thresholds: basic 6 joins in 30 s, guarded 5 in 25 s, fortress 4 in 20 s."
    ],
    "options": [
     {
      "name": "tier",
      "type": "Text",
      "required": true,
      "description": "Preset tier to apply. Values: basic, guarded, fortress, unprotected."
     }
    ]
   },
   {
    "name": "/opsec servershow",
    "description": "Show or hide this server in the carousel on drewbot.xyz.",
    "notes": [
     "off hides this server from the carousel on drewbot.xyz, on shows it again. Servers are shown by default. Doesn't need SUDO."
    ],
    "options": [
     {
      "name": "state",
      "type": "Text",
      "required": true,
      "description": "on shows the server, off hides it. Values: on, off."
     }
    ]
   }
  ]
 },
 {
  "id": "sudo",
  "label": "SUDO",
  "order": 980,
  "intro": "SUDO mode protects sensitive changes with a password that only the server owner sets, so a compromised admin account can't switch your protection off.",
  "notes": [
   "Sessions last 15 minutes. Use /sudo exit to end one early."
  ],
  "commands": [
   {
    "name": "/sudo enter",
    "description": "Enter SUDO mode for 15 minutes.",
    "notes": [
     "Requires the Administrator permission."
    ],
    "options": [
     {
      "name": "password",
      "type": "Text",
      "required": false,
      "description": "Required after the server owner configures SUDO"
     }
    ]
   },
   {
    "name": "/sudo exit",
    "description": "Exit SUDO mode immediately.",
    "notes": [],
    "options": []
   },
   {
    "name": "/sudo status",
    "description": "Check current SUDO session status.",
    "notes": [],
    "options": []
   },
   {
    "name": "/sudo setup",
    "description": "Configure SUDO protection (Owner only).",
    "notes": [
     "Server owner only."
    ],
    "options": [
     {
      "name": "password",
      "type": "Text",
      "required": true,
      "description": "Set or update the SUDO password"
     }
    ]
   }
  ]
 },
 {
